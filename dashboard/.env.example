# Copy to .env.local for local testing. On Vercel, set these in Project Settings -> Environment Variables.

# Password to sign in to the dashboard.
DASHBOARD_PASSWORD=
# Any long random string (e.g. from: openssl rand -hex 32). Signs the login cookie.
SESSION_SECRET=

# Your lead-scout repository, and a fine-grained token for it with
# "Contents: Read and write" and "Actions: Read and write".
GITHUB_REPO=IdowuJosiah/lead-scout
GITHUB_TOKEN=

# Optional: branch names (defaults shown).
# STATE_BRANCH=agent-data
# CODE_BRANCH=main

# Local testing only: read/write a local state folder instead of GitHub.
# LOCAL_STATE_DIR=../state
